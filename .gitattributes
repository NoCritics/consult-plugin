# Normalise to LF in the repository. Without this, a fresh clone on Windows
# warns on every file and can commit CRLF into shell scripts that CI runs on
# Linux. Working-copy line endings are still whatever core.autocrlf dictates.
* text=auto eol=lf

# Binaries must never be munged.
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Generated by mcp/build-vendor.js: kept out of diffs and language stats.
mcp/vendor/** linguist-generated=true -diff
